# TRON Transfer Owner Admin — server-side configuration template.
# Copy to a local, ignored .env file only. Never commit real values.
# Never expose any value below through Vite/VITE_* frontend variables.
NODE_ENV=development
PORT=10000
FRONTEND_ORIGIN=http://localhost:5173

# Existing Neon PostgreSQL only. Use a direct URL for migration commands;
# runtime may use the existing pooled connection where configured.
DATABASE_URL=
DATABASE_URL_POOLED=
OWNER_ADMIN_DATABASE_URL=
SPONSOR_DATABASE_URL=
SPONSOR_DATABASE_URL_POOLED=

# Mainnet RPC/data connectivity. Tatum is the primary read path;
# TronGrid is the fallback and the existing broadcast/history path.
TATUM_API_KEY=
TATUM_TRON_NETWORK=mainnet
TATUM_TRON_RPC_URL=https://tron-mainnet.gateway.tatum.io
TRONGRID_API_KEY=

# Public Mainnet identities only. Never put wallet private keys here.
TRON_OWNER_ADDRESS=
SPONSOR_MAINNET_ADDRESS=
TRAX_CONTRACT_ADDRESS=

# Managed wallet auth/bootstrap. Generate independent random secrets locally.
# Enrollment tokens are one-time; remove them after successful enrollment.
TRON_OWNER_ENROLLMENT_TOKEN=
TRON_SPONSOR_ENROLLMENT_TOKEN=
OWNER_ADMIN_EXPECTED_DATABASE_IDENTITY_SHA256=
SPONSOR_SESSION_SECRET=

# Keep all production execution controls disabled until separately approved.
OWNER_OPERATION_LEDGER_DURABLE=false
OWNER_OPERATION_LEDGER_BACKUP_VERIFIED=false
OWNER_OPERATION_LEDGER_RESTORE_TESTED=false
OWNER_OPERATION_EXECUTION_ENABLED=false
OWNER_OPERATION_MAINNET_ACK=
OWNER_MAX_FEE_LIMIT_SUN=
SPONSOR_LEDGER_DURABLE=false
SPONSOR_LEDGER_BACKUP_VERIFIED=false
SPONSOR_LEDGER_RESTORE_TESTED=false
SPONSOR_TRANSACTION_ENGINE_ENABLED=false
SPONSOR_MAINNET_BROADCAST_ENABLED=false
SPONSOR_WRITES_RELEASE_ENABLED=false

# Sponsor risk limits. Zero fee/stake caps fail closed until explicitly set.
SPONSOR_LIQUID_RESERVE_TRX=2
SPONSOR_STAKING_ENABLED=false
SPONSOR_MAX_AUTOMATIC_STAKE_TRX=0
SPONSOR_MAX_OWNER_TOPUP_TRX=0
SPONSOR_MAX_TX_FEE_SUN=0

# Pinned TRӾ deployment artifact identity and fee ceilings.
# Populate only from the reviewed/generated artifact for the unchanged contract.
TRAX_SOURCE_SHA256=
TRAX_CREATION_BYTECODE_SHA256=
TRAX_RUNTIME_BYTECODE_SHA256=
TRAX_DEPLOYMENT_ARTIFACT_SHA256=
TRAX_DEPLOYMENT_EXECUTION_ENABLED=false
TRAX_DEPLOYMENT_MAINNET_ACK=
TRAX_DEPLOYMENT_LEDGER_DURABLE=false
TRAX_DEPLOYMENT_LEDGER_BACKUP_VERIFIED=false
TRAX_DEPLOYMENT_LEDGER_RESTORE_TESTED=false
TRAX_DEPLOYMENT_ORIGIN_ENERGY_LIMIT=
TRAX_ACCEPT_OWNERSHIP_FEE_LIMIT_SUN=
TRAX_ACCEPT_OWNERSHIP_MAX_FEE_LIMIT_SUN=
OWNER_MAX_FEE_LIMIT_SUN=
TRAX_DEPLOYMENT_MAX_FEE_LIMIT_SUN=
