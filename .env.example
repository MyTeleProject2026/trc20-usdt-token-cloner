# Backend-only environment template. Do not put secrets in frontend variables.
# Required for Tatum API routes and TRON gateway balance queries.
TATUM_API_KEY=
# Optional; tatum-client.mjs only accepts the official https://api.tatum.io origin.
TATUM_API_BASE=https://api.tatum.io

# Optional TronGrid key for routes that explicitly use TronGrid.
TRONGRID_API_KEY=

# Optional server-side TronScan Pro API key for better availability on Mainnet token source/risk metadata.
# Mainnet-only explorer data; never expose this as a VITE_ variable. No key means public unauthenticated lookup.
TRONSCAN_PRO_API_KEY=

# Extra reviewed token contracts accepted by the read-only event verifier.
# Comma-separated hex addresses, with or without the TRON 41 prefix.
# Official TRON Mainnet USDT is built in and is accepted only on Mainnet;
# testnet contracts and all other token contracts still require explicit review.
TRON_VERIFIED_TOKEN_CONTRACTS=

# Privileged sponsor-ledger GET/POST routes; server-only token with at least 32 characters.
SPONSOR_ADMIN_API_TOKEN=
# Semicolon-separated approval scopes, each: reference|sponsorReference|network|sponsorAddress|purpose|asset|tokenContract.
# Use '-' for tokenContract on TRX budgets; add a scope only after reviewing signed sponsor terms.
SPONSOR_APPROVED_AGREEMENT_REFERENCES=
# Separate release gate for Mainnet budget activation; this does not enable transfer submission.
SPONSOR_MAINNET_BUDGET_ACTIVATION_ENABLED=false
# Explicit opt-in for the experimental sponsor-owned signing/broadcast path on Shasta/Nile only.
# Keep false until testnet funding/consent, supported wallet signing, resource checks, and E2E reconciliation are independently validated.
SPONSOR_TESTNET_SIGNED_BROADCAST_ENABLED=false
# Maximum transaction fee_limit for sponsor-built TRC20 testnet transactions, in SUN.
SPONSOR_TESTNET_MAX_FEE_LIMIT_SUN=50000000

# Owner-only Wallet Vault treasury check.
# Identity allowed to view the read-only treasury snapshot (must sign in locally).
TREASURY_OWNER_ADDRESS=
# Public address to monitor for the treasury's live TRX and official Mainnet USDT.
# If blank, the backend falls back to SPONSOR_MAINNET_ADDRESS, then TREASURY_OWNER_ADDRESS.
# This is watch-only; never paste a private key or seed phrase here.
TREASURY_MAINNET_ADDRESS=

# Optional read-only sponsor funding snapshots; these are public on-chain addresses, not keys.
# Configure only addresses the project is authorized to monitor. No signing key is accepted.
SPONSOR_MAINNET_ADDRESS=
SPONSOR_SHASTA_ADDRESS=
SPONSOR_NILE_ADDRESS=

# Independent read-only sponsor account addresses. Configure only accounts authorized for monitoring.
# Fee sponsor: resource/fee coverage diagnostics. Asset sponsor: actual TRX/token principal diagnostics.
# These are public addresses, not private keys. Configuration does not enable transfers.
SPONSOR_FEE_MAINNET_ADDRESS=
SPONSOR_FEE_SHASTA_ADDRESS=
SPONSOR_FEE_NILE_ADDRESS=
SPONSOR_ASSET_MAINNET_ADDRESS=
SPONSOR_ASSET_SHASTA_ADDRESS=
SPONSOR_ASSET_NILE_ADDRESS=
# Mainnet USDT is fixed to the official Tether TRON contract by the backend.
# Nile/Shasta USDT-labelled contracts are test assets, not genuine Tether Mainnet USDT.
SPONSOR_USDT_SHASTA_CONTRACTS=
SPONSOR_USDT_NILE_CONTRACTS=

# GasFree provider discovery only (TRON Mainnet + Nile testnet).
# Apply to GasFree for API access first. Keep these server-side; never use VITE_*.
# This integration is read-only and does not submit transfers or verify sponsor funding.
GASFREE_MAINNET_API_KEY=
GASFREE_MAINNET_API_SECRET=
GASFREE_NILE_API_KEY=
GASFREE_NILE_API_SECRET=

# Single-owner private console login. No public registration exists.
# Must match TREASURY_OWNER_ADDRESS exactly. Public address only.
OWNER_WALLET_ADDRESS=
# Scrypt password hash from: node scripts/generate-owner-password-hash.mjs
# Use a long random password (minimum 16 characters); never configure plaintext.
OWNER_PASSWORD_HASH=

# Backend persistence and frontend CORS allowlist.
DATABASE_URL=
DATABASE_SSL=false
# Exact comma-separated browser origins, e.g. https://trc20-usdt-token-cloner.onrender.com
# Empty/invalid configuration blocks browser-origin requests; it never reflects any origin.
FRONTEND_ORIGIN=
# Optional additive allowlist for packaged apps; does not replace FRONTEND_ORIGIN.
# Only enable for the reviewed local-origin clients described in docs/APP_INSTALLERS.md.
PACKAGED_APP_ORIGINS=https://localhost,tronstudio://app


# Optional read-only OKX deposit-status page for one account whose owner authorized access.
# Create the exchange key with Read permission only; never grant Trade or Withdraw.
OKX_UI_ORIGIN=https://trc20-usdt-token-cloner.onrender.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_STATUS_ACCESS_TOKEN=

# Optional protected diagnostic and receiver-watchlist administration.
# Each token must be independently generated, random, and at least 32 characters.
# TREASURY_ADMIN_API_TOKEN protects the read-only /api/treasury/payout-readiness endpoint.
# RECEIVER_WATCHLIST_ADMIN_TOKEN is only needed when the protected watchlist feature is used.
TREASURY_ADMIN_API_TOKEN=
RECEIVER_WATCHLIST_ADMIN_TOKEN=

# Never set wallet private keys, seed phrases, or recovery phrases here. Provider API
# credentials above are not wallet keys and must only be configured server-side.


# Tron Transfer dedicated frontend and Tatum-backed RPC.
# Set this exact public frontend origin in the backend Render service CORS allowlist.
TRON_TRANSFER_UI_ORIGIN=https://tron-transfer.onrender.com
# Prefer separate, network-scoped Tatum keys. The general TATUM_API_KEY is a fallback only.
# Tatum keys are private; never add them to VITE_* variables or commit actual values.
TATUM_MAINNET_API_KEY=
TATUM_TESTNET_API_KEY=

# Private owner-only direct-wallet sponsor flow (no provider liquidity/credit).
# The sponsor's own wallet holds the USDT, covers TRON resources and signs each exact payout.
# Reconciliation starts automatically when DATABASE_URL and a Tatum Mainnet key are configured.
SPONSOR_DIRECT_RECONCILIATION_WORKER_ENABLED=true
SPONSOR_DIRECT_RECONCILIATION_INTERVAL_MS=45000
# Maximum transaction fee_limit in SUN; this is a cap, not the actual fee charged.
SPONSOR_DIRECT_TRON_USDT_FEE_LIMIT_SUN=100000000

# External payout provider integration is currently disabled.
# No provider credentials are used until a provider explicitly authorizes this owner
# for provider-owned USDT liquidity or a documented credit facility. Legacy Fincra
# and Fireblocks payout environment variables are not part of the active deployment.


# Restricted native TRX escrow viewer. Public frontend address only.
# Leave blank until the escrow contract has passed independent audit and is
# deployed/verified on TRON Mainnet. Never put provider credentials in VITE_*.
VITE_RESTRICTED_TRX_ESCROW_ADDRESS=


# Restricted native TRX provider comparison / credit readiness (server only).
# Ripple is selected for technical diligence only. Selection does not approve credit or enable payouts.
# Do not set an alternate provider without reviewing and implementing its official API adapter.
RESTRICTED_TRX_PROVIDER=ripple
RESTRICTED_TRX_PROVIDER_ACCOUNT_ID=
RESTRICTED_TRX_PROVIDER_API_KEY=
RESTRICTED_TRX_PROVIDER_API_SECRET=
# This records owner configuration only; it is NOT proof of provider credit.
RESTRICTED_TRX_PROVIDER_AGREEMENT_CONFIRMED=false
RESTRICTED_TRX_ESCROW_CONTRACT=
# SHA-256 of the deployed, independently audited runtime bytecode (raw hex bytes).
# Keep blank until the audited contract is deployed and runtime code is independently verified.
RESTRICTED_TRX_ESCROW_RUNTIME_CODE_SHA256=

# Public TRON solidified-node read access (read-only; no funding, signing, or broadcasting).
TRONGRID_API_ORIGIN=https://api.trongrid.io
TRONGRID_API_KEY=

# Restricted TRX escrow verification. Set only after an independently audited
# contract is deployed and its Mainnet address is verified on-chain.
# TREASURY_OWNER_ADDRESS must match the private owner wallet used for sign-in.
TREASURY_OWNER_ADDRESS=
RESTRICTED_TRX_ESCROW_CONTRACT=
RESTRICTED_TRX_BENEFICIARY_ADDRESS=

# Optional Bitpie multisignature destination. If configured, use the actual
# Bitpie multisig account address, not the participant's ordinary single-key
# wallet address. The multisig address may differ from the original wallet.
VITE_RESTRICTED_TRX_BENEFICIARY_ADDRESS=

# Exact Bitpie or Bitpie-multisig beneficiary address. Set the same confirmed
# TRON Mainnet address here and in VITE_RESTRICTED_TRX_BENEFICIARY_ADDRESS.
# A multisig address may be different from the original single-signature wallet.
RESTRICTED_TRX_BENEFICIARY_ADDRESS=
