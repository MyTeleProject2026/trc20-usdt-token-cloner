{
  "name": "tron-transfer-resource-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretest": "npm install --no-audit --no-fund",
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.js && node --check scripts/check-wallet-auth-schema.mjs && node --check sponsor-api.mjs && node --check managed-wallet-identities.mjs && node --check sponsor-engine.mjs && node --check remote-sponsor-signer.mjs && node --check scripts/migrate-sponsor-ledger.mjs && node --check scripts/check-sponsor-ledger-migration.mjs && node --check scripts/sponsor-ledger-database-identity.mjs && node --check scripts/run-sponsor-ledger-migration.mjs",
    "migrate:sponsor-ledger": "node scripts/migrate-sponsor-ledger.mjs",
    "check:migrate:sponsor-ledger": "node scripts/check-sponsor-ledger-migration.mjs",
    "sponsor-ledger:pause": "node scripts/run-sponsor-ledger-migration.mjs pause",
    "sponsor-ledger:preflight": "node scripts/run-sponsor-ledger-migration.mjs preflight",
    "sponsor-ledger:migrate": "node scripts/run-sponsor-ledger-migration.mjs migrate",
    "smoke:production-acceptance": "node scripts/production-acceptance-smoke.mjs",
    "check:wallet-auth-schema": "node scripts/check-wallet-auth-schema.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "tronweb": "6.5.2"
  },
  "overrides": {
    "axios": "^1.19.1",
    "tmp": "^0.2.6",
    "ws": "^8.20.2",
    "ethers": "6.17.0",
    "google-protobuf": "4.0.3",
    "follow-redirects": "1.16.2"
  }
}
