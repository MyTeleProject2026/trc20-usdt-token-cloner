{
  "name": "tron-transfer-mainnet-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/compile-trax-contracts.mjs && vite",
    "build": "node scripts/compile-trax-contracts.mjs && node --test tests/*.test.mjs && vite build && node scripts/export-trax-verification-bundle.mjs",
    "test": "node scripts/compile-trax-contracts.mjs && node --test tests/*.test.mjs",
    "verification:bundle": "node scripts/export-trax-verification-bundle.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tronweb": "6.5.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "vite": "6.4.5",
    "@vitejs/plugin-react": "4.7.0",
    "solc": "0.8.25"
  }
}
